const express = require('express');
const mongoose = require('mongoose');
const cors = require('cors');
const multer = require('multer');
const path = require('path');
const fs = require('fs');

const app = express();
const PORT = process.env.PORT || 10000;

// ==========================================
// 1. ENGINE MIDDLEWARES & CONFIGURATION
// ==========================================
app.use(cors({ origin: '*' }));
app.use(express.json());
app.use(express.urlencoded({ extended: true }));

// Secure local data spool directory compatible with cloud platforms
const uploadDir = path.join('/tmp', 'generic_uploads');
if (!fs.existsSync(uploadDir)) {
    fs.mkdirSync(uploadDir, { recursive: true });
}

const storage = multer.diskStorage({
    destination: (req, file, cb) => { cb(null, uploadDir); },
    filename: (req, file, cb) => {
        cb(null, Date.now() + '-' + file.originalname);
    }
});

// Configured specifically to look for the 'files' identifier sent by the frontend
const upload = multer({ storage: storage });

// ==========================================
// 2. DATABASE CONFIGURATION
// ==========================================
const MONGO_URI = process.env.MONGO_URI || "mongodb://usrtest:canada2026secure@cluster0-shard-00-00.q9tcm7y.mongodb.net:27017,cluster0-shard-00-01.q9tcm7y.mongodb.net:27017,cluster0-shard-00-02.q9tcm7y.mongodb.net:27017/immigration?ssl=true&replicaSet=atlas-13w7g2-shard-0&authSource=admin&retryWrites=true&w=majority";

mongoose.connect(MONGO_URI)
  .then(() => console.log('🚀 Base Registry Database Connected'))
  .catch(err => console.log('❌ Database Connection Failure:', err.message));

const ClientSchema = new mongoose.Schema({
    name: { type: String, required: true },
    email: { type: String, required: true, unique: true },
    password: { type: String, required: true },
    dob: String,
    citizenship: String,
    passportNumber: String,
    role: { type: String, default: 'user' },
    status: { type: String, default: 'File Created: Pending Document Verification' },
    adminNotes: { type: String, default: 'Application successfully received into system pipeline.' }
});

const Client = mongoose.models.Client || mongoose.model('Client', ClientSchema);

// ==========================================
// 3. API ROUTING PIPELINES
// ==========================================

// Explicit alignment with the 'files' input parameter fixes the 500 error
app.post('/api/auth/register', upload.array('files', 5), async (req, res) => {
    try {
        const { name, email, password, dob, citizenship, passportNumber } = req.body;
        
        if (!name || !email || !password) {
            return res.status(400).json({ error: 'Required validation parameters missing.' });
        }

        const existingClient = await Client.findOne({ email: email.toLowerCase().trim() });
        if (existingClient) {
            return res.status(409).json({ error: 'This email is already registered in the system.' });
        }

        const adminEmail = (process.env.ADMIN_EMAIL || 'admin@portal.com').toLowerCase().trim();
        const role = (email.toLowerCase().trim() === adminEmail) ? 'admin' : 'user';

        const newClient = new Client({
            name,
            email: email.toLowerCase().trim(),
            password, 
            dob,
            citizenship,
            passportNumber,
            role
        });

        await newClient.save();

        // Perform clean file lifecycle management on completion
        if (req.files && req.files.length > 0) {
            req.files.forEach(file => {
                fs.unlink(file.path, (err) => { if (err) console.error("Cleanup warning:", err); });
            });
        }

        res.status(201).json({ success: true, message: 'Registration profile and attachments verified.' });
    } catch (error) {
        console.error("System pipeline intercept:", error);
        res.status(500).json({ error: 'Server validation error encountered during binary conversion.' });
    }
});

app.post('/api/auth/login', async (req, res) => {
    try {
        const { email, password } = req.body;
        const user = await Client.findOne({ email: email.toLowerCase().trim(), password });
        
        if (!user) return res.status(401).json({ error: 'Invalid identification parameters.' });
        
        res.json({ success: true, role: user.role, name: user.name, email: user.email });
    } catch (error) {
        res.status(500).json({ error: 'Internal validation gateway timeout.' });
    }
});

app.get('/api/admin/records', async (req, res) => {
    try {
        const records = await Client.find({ role: 'user' });
        res.json(records);
    } catch (err) {
        res.status(500).json({ error: 'Failed to access system registry.' });
    }
});

app.post('/api/admin/modify', async (req, res) => {
    try {
        const { id, status, adminNotes } = req.body;
        await Client.findByIdAndUpdate(id, { status, adminNotes });
        res.json({ success: true });
    } catch (err) {
        res.status(500).json({ error: 'Failed to commit updates to backend database.' });
    }
});

// ==========================================
// 4. USER INTERFACE LAYOUTS (NEUTRAL DESIGN)
// ==========================================
